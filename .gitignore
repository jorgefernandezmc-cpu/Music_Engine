# ==============================================================================
#                             GITIGNORE - MUSIC ENGINE
# ==============================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing, Coverage & Linters
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache/
.mypy_cache/
.ruff_cache/

# Virtual Environment
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment Variables & Secrets (NEVER COMMIT)
.env
config/.env
*.env
!config/.env.template
!*.env.template
*.pem
*.key

# Local User Configuration & Credentials
config/config.yaml
config/cookies.txt
config/headers_auth.json

# Keep template configurations in repository
!config/.env.template
!config/config.yaml.template

# Runtime Data, SQLite Databases, Backups & State
data/*
!data/.gitkeep
!data/*.template
!data/backups/
data/backups/*
!data/backups/.gitkeep
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.db
*.lock

# Audio, Lyrics & Playlist Files (Prevent accidental commit of personal media)
*.opus
*.m4a
*.mp3
*.flac
*.ogg
*.wav
*.aac
*.wma
*.lrc
*.m3u
*.m3u8
lune_playlists_backup.json

# Logs
logs/*
!logs/.gitkeep
*.log

# Build & Packaging
build/
dist/
downloads/
*.egg-info/
.eggs/

# IDEs, Editors & OS Files
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.tmp
*.temp
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Syncthing conflict & temporary files
*.sync-conflict-*
.stversions/
.stfolder/
